# Copy this file to .env and fill in real values before deploying.
# APP_ENV=production refuses to boot unless every required value below is
# actually set — see app/core/config.py Settings.validate_for_production().

APP_ENV=development

# --- core infra ------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://charter123:charter123_dev_password@localhost:5432/charter123
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-to-a-random-64-char-string
FIELD_ENCRYPTION_KEY=

# --- auth / admin bootstrap (Phase 4) ---------------------------------------
# Leave BOOTSTRAP_ADMIN_ENABLED=false except for the one-time run of
# `python -m app.db.bootstrap_admin` on a fresh install. Settings.
# validate_for_production() refuses to start the app at all if this is left
# true with APP_ENV=production — see app/core/config.py.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Vapi --------------------------------------------------------------
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=

# --- airline provider --------------------------------------------------
# mock | amadeus | sabre — system runs fully featured with zero aviation
# credentials when this is "mock". See docs/AIRLINE_PROVIDER.md.
AIRLINE_PROVIDER=mock
AIRLINE_API_BASE_URL=
AIRLINE_API_KEY=
AIRLINE_API_SECRET=
AIRLINE_CLIENT_ID=
AIRLINE_CLIENT_SECRET=
AIRLINE_ENVIRONMENT=

# --- payments (Phase 6 Milestone 1) ---------------------------------------
# mock | stripe — see app/providers/payments/__init__.py. Leave as mock for
# local dev; only set to stripe once STRIPE_SECRET_KEY/STRIPE_WEBHOOK_SECRET
# below are real test-mode values.
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- notifications -------------------------------------------------------
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- web / cors ----------------------------------------------------------
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- observability ---------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=INFO

# --- data retention (days) — see docs/PRODUCTION_CHECKLIST.md §GDPR --------
CALL_TRANSCRIPT_RETENTION_DAYS=90
CALL_RECORDING_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=730
CALL_RECORDING_ENABLED=false
RECORDING_DISCLOSURE_MESSAGE="This call may be recorded for quality and training purposes."
