# Copy this file to .env and fill in real values before deploying.
# APP_ENV=production refuses to boot unless every required value below is
# actually set — see app/core/config.py Settings.validate_for_production().

APP_ENV=development

# --- core infra ------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://charter123:charter123_dev_password@localhost:5432/charter123
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-to-a-random-64-char-string
FIELD_ENCRYPTION_KEY=

# --- auth / admin bootstrap (Phase 4) ---------------------------------------
# Leave BOOTSTRAP_ADMIN_ENABLED=false except for the one-time run of
# `python -m app.db.bootstrap_admin` on a fresh install. Settings.
# validate_for_production() refuses to start the app at all if this is left
# true with APP_ENV=production — see app/core/config.py.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Vapi --------------------------------------------------------------
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=

# --- Vapi setup script only (T-4 / scripts/setup_vapi.py) ------------------
# NOT read by the running app — app/core/config.py has no fields for these.
# Only scripts/setup_vapi.py reads them, directly via os.environ, when you
# run it with --apply against a real Vapi account. See that script's own
# module docstring before using it — it has never been run against a real
# account from this repo.
# The full public webhook URL Vapi should call, e.g.
# https://your-domain.com/api/v1/vapi/webhook — required for --apply.
VAPI_SERVER_URL=
# Optional. Vapi's current docs describe a dashboard-managed "Custom
# Credentials" system as the primary webhook-auth mechanism now (the older
# inline VAPI_WEBHOOK_SECRET above is kept working under an explicit
# migration note, and is what the script uses by default). If you've
# created a Custom Credential by hand in the Vapi dashboard and want the
# script to reference it instead of the inline secret, put its ID here.
VAPI_WEBHOOK_CREDENTIAL_ID=
# Optional. E.164 destination number for the native transferCall tool
# (docs/VAPI.md "Transfer to human"). If left blank, setup_vapi.py skips
# creating that tool entirely.
VAPI_TRANSFER_NUMBER=

# --- airline provider --------------------------------------------------
# mock | amadeus | sabre — system runs fully featured with zero aviation
# credentials when this is "mock". See docs/AIRLINE_PROVIDER.md.
AIRLINE_PROVIDER=mock
AIRLINE_API_BASE_URL=
AIRLINE_API_KEY=
AIRLINE_API_SECRET=
AIRLINE_CLIENT_ID=
AIRLINE_CLIENT_SECRET=
AIRLINE_ENVIRONMENT=

# --- payments (Phase 6 Milestone 1) ---------------------------------------
# mock | stripe — see app/providers/payments/__init__.py. Leave as mock for
# local dev; only set to stripe once STRIPE_SECRET_KEY/STRIPE_WEBHOOK_SECRET
# below are real test-mode values.
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- notifications (Phase 8, T-5) -----------------------------------------
# mock | resend — see app/services/email_provider.py. Leave as mock for
# local dev; only set to resend once RESEND_API_KEY/EMAIL_FROM_ADDRESS
# below are real values.
EMAIL_PROVIDER=mock
EMAIL_FROM_ADDRESS=
RESEND_API_KEY=
# mock | twilio — see app/services/sms_provider.py. Leave as mock for
# local dev; only set to twilio once the three TWILIO_* values below are
# real (a purchased/verified Twilio number for TWILIO_PHONE_NUMBER).
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- web / cors ----------------------------------------------------------
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- observability ---------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=INFO

# --- data retention (days) — see docs/PRODUCTION_CHECKLIST.md §GDPR --------
CALL_TRANSCRIPT_RETENTION_DAYS=90
CALL_RECORDING_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=730
CALL_RECORDING_ENABLED=false
RECORDING_DISCLOSURE_MESSAGE="This call may be recorded for quality and training purposes."
